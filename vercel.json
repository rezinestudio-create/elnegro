  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/checkout", "destination": "/api/checkout.js" },
    { "source": "/api/products", "destination": "/api/products.js" },
    { "source": "/api/status", "destination": "/api/status.js" },
